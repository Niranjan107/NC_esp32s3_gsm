# ESP32-S3 Target
CONFIG_IDF_TARGET="esp32s3"

# Flash Configuration
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS Configuration
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# Main Task Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Bluetooth Configuration - Bluedroid Stack (NOT NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# BLE Configuration
CONFIG_BT_ACL_CONNECTIONS=3
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=n

# GATT Configuration
CONFIG_BT_GATT_MAX_SR_PROFILES=8
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=500

# BLE SPP Configuration
CONFIG_BLE_SPP_ENABLED=y

# UART Configuration
# Disabled UART_ISR_IN_IRAM to fix uart_read_bytes crash in ESP-IDF v5.5
CONFIG_UART_ISR_IN_IRAM=n

# Console Configuration (USB CDC)
# Use USB-CDC for console (completely frees UART0 for data)
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_UART_NONE=y

# Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# NVS Configuration
CONFIG_NVS_ENCRYPTION=n

# Watchdog Configuration
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Power Management (disabled for now)
CONFIG_PM_ENABLE=n

# Heap Configuration
CONFIG_HEAP_POISONING_DISABLED=y

# lwIP PPP - required for the GSM modem to be a real network interface
# (esp_modem + esp_netif), so the application layer can use normal TCP
# sockets instead of AT-command HTTP. See docs/GSM_PORT_PLAN.md Step 1.
# NOTE: the committed sdkconfig overrides this file, so it is set in both.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y

# LCP echo keepalive - REQUIRED, not optional.
# Without it PPP never notices the peer has gone: with the modem powered off
# mid-session the link stayed "connected" indefinitely, reporting data=1 while
# nothing could possibly flow. AT commands cannot be used to check, because the
# UART is carrying PPP frames - the keepalive is the only signal available.
# 3s interval x 3 failures = dead link detected in about 9 seconds.
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=3
CONFIG_LWIP_LCP_MAXECHOFAILS=3


# Application layer (Step 4): MQTT publish + offline store-and-forward.
# Same values as the WiFi product - only the transport underneath differs.
CONFIG_NCLE_MQTT_ENABLE=y
CONFIG_NCLE_MQTT_BROKER_URI="mqtt://broker.hivemq.com:1883"
CONFIG_NCLE_MQTT_USERNAME=""
CONFIG_NCLE_MQTT_PASSWORD=""
CONFIG_NCLE_MQTT_RESTRICT_RISKY_CMDS=y
CONFIG_NCLE_MQTT_STORE_FORWARD=y

# Weight-capture tuning (must stay in step with the WiFi product and the app)
CONFIG_NCLE_WM_GRACE_MS=200
CONFIG_NCLE_WM_GRACE_CONTINUOUS_MS=2000
CONFIG_NCLE_WM_STALE_MS=5000
CONFIG_NCLE_WM_REPEAT_MIN=4
# CONFIG_NCLE_MA_ADAPTIVE_TIMEOUT is not set
