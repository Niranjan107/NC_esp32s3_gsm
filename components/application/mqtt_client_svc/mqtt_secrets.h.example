/**
 * @file mqtt_secrets.h.example
 * @brief TEMPLATE for per-site broker credentials. COPY, DO NOT EDIT THIS FILE.
 *
 *   copy  mqtt_secrets.h.example  ->  mqtt_secrets.h   (same folder)
 *
 * `mqtt_secrets.h` is in .gitignore, so real broker addresses and passwords
 * never reach the repository. The build does NOT depend on it: if the file is
 * absent, mqtt_client_svc.c falls back to the menuconfig values
 * (CONFIG_NCLE_MQTT_BROKER_URI / _USERNAME / _PASSWORD), which default to the
 * public test broker with no authentication.
 *
 * Define only what you need to override - each macro is independent.
 */
#ifndef MQTT_SECRETS_H
#define MQTT_SECRETS_H

/* Broker URI. mqtts:// = TLS (port 8883), mqtt:// = plain (port 1883). */
#define NCLE_MQTT_URI   "mqtts://<your-cluster>.s1.eu.hivemq.cloud:8883"

/* Leave the username empty ("") for brokers that allow anonymous clients. */
#define NCLE_MQTT_USER  "<username>"
#define NCLE_MQTT_PASS  "<password>"

#endif /* MQTT_SECRETS_H */
